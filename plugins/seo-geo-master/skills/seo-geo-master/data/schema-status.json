{
  "verified": "2026-10-02",
  "sources": [
    "https://developers.google.com/search/docs/appearance/structured-data/search-gallery",
    "https://developers.google.com/search/updates",
    "https://developers.google.com/search/blog/2023/08/howto-faq-changes",
    "https://developers.google.com/search/blog/2025/06/simplifying-search-results"
  ],
  "note": "since = the date Google ended, announced the end of, or removed docs for the rich result (see each type's note). selfServingReviews: true = Google shows no review stars when this type carries ratings about itself.",
  "types": {
    "Article": { "richResult": "active", "required": [] },
    "NewsArticle": { "richResult": "active", "required": [] },
    "BlogPosting": { "richResult": "active", "required": [] },
    "BreadcrumbList": { "richResult": "active", "required": [["itemListElement"]] },
    "Product": { "richResult": "active", "required": [["name"], ["offers", "review", "aggregateRating"]] },
    "Offer": { "richResult": "active", "required": [["price", "priceSpecification"]] },
    "AggregateOffer": { "richResult": "active", "required": [["lowPrice"], ["priceCurrency"]] },
    "AggregateRating": { "richResult": "active", "required": [["ratingValue"], ["ratingCount", "reviewCount"]] },
    "Review": { "richResult": "active", "required": [["author"], ["reviewRating"]] },
    "LocalBusiness": { "richResult": "active", "required": [["name"], ["address"]], "selfServingReviews": true },
    "Organization": { "richResult": "active", "required": [], "selfServingReviews": true },
    "Restaurant": { "inherits": "LocalBusiness" },
    "Store": { "inherits": "LocalBusiness" },
    "FurnitureStore": { "inherits": "LocalBusiness" },
    "ProfessionalService": { "inherits": "LocalBusiness" },
    "HomeAndConstructionBusiness": { "inherits": "LocalBusiness" },
    "HealthAndBeautyBusiness": { "inherits": "LocalBusiness" },
    "MedicalBusiness": { "inherits": "LocalBusiness" },
    "LegalService": { "inherits": "LocalBusiness" },
    "AutoRepair": { "inherits": "LocalBusiness" },
    "Event": { "richResult": "active", "required": [["name"], ["startDate"], ["location"]] },
    "VideoObject": { "richResult": "active", "required": [["name"], ["thumbnailUrl"], ["uploadDate"]] },
    "Recipe": { "richResult": "active", "required": [["name"], ["image"]] },
    "JobPosting": { "richResult": "active", "required": [["title"], ["description"], ["datePosted"], ["hiringOrganization"], ["jobLocation", "applicantLocationRequirements"]] },
    "SoftwareApplication": { "richResult": "active", "required": [["name"], ["offers"], ["aggregateRating", "review"]] },
    "DiscussionForumPosting": { "richResult": "active", "required": [["author"], ["datePublished"], ["text", "image", "video"]] },
    "QAPage": { "richResult": "active", "required": [["mainEntity"]] },
    "ProfilePage": { "richResult": "active", "required": [["mainEntity"]] },
    "FAQPage": { "richResult": "retired", "since": "2026-05-07", "note": "limited to well-known government and health sites on 2023-08-08, then ended for all sites on 2026-05-07" },
    "HowTo": { "richResult": "retired", "since": "2023-09-13", "note": "HowTo rich results were removed in 2023" },
    "SpecialAnnouncement": { "richResult": "retired", "since": "2025-06-12", "note": "retired in Google's 2025 simplification of search results" },
    "ClaimReview": { "richResult": "retired", "since": "2025-06-12", "note": "retired in Google's 2025 simplification of search results" },
    "Occupation": { "richResult": "retired", "since": "2025-06-12", "note": "the estimated salary rich result was retired in 2025" },
    "Quiz": { "richResult": "retired", "since": "2026-01-06", "note": "the practice problem rich result was retired and its docs removed" },
    "Dataset": { "richResult": "dataset-search-only", "since": "2025-11-05", "note": "Dataset markup now serves Dataset Search only" }
  }
}
